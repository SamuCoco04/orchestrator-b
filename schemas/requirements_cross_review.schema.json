{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "review_version",
    "missing_coverage",
    "too_generic",
    "duplicates_or_overlaps",
    "required_actions",
    "notes"
  ],
  "properties": {
    "review_version": {"type": "string"},
    "missing_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["area", "current", "target", "add"],
        "properties": {
          "area": {"type": "string"},
          "current": {"type": "integer", "minimum": 0},
          "target": {"type": "integer", "minimum": 0},
          "add": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "too_generic": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "reason", "fix"],
        "properties": {
          "id": {"type": "string"},
          "reason": {"type": "string"},
          "fix": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "duplicates_or_overlaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ids", "reason", "merge_or_split"],
        "properties": {
          "ids": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 2
          },
          "reason": {"type": "string"},
          "merge_or_split": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "required_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "area", "count", "ids", "instruction"],
        "properties": {
          "type": {"type": "string", "enum": ["ADD", "REWRITE", "SPLIT", "MERGE"]},
          "area": {"type": ["string", "null"]},
          "count": {"type": ["integer", "null"], "minimum": 0},
          "ids": {
            "type": "array",
            "items": {"type": "string"}
          },
          "instruction": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
