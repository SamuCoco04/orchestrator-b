{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "missing_areas",
    "duplication_suspects",
    "too_generic",
    "domain_missing",
    "required_actions"
  ],
  "properties": {
    "missing_areas": {
      "type": "array",
      "items": {"type": "string"}
    },
    "duplication_suspects": {
      "type": "array",
      "items": {"type": "string"}
    },
    "too_generic": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "reason"],
        "properties": {
          "id": {"type": "string"},
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "domain_missing": {
      "type": "array",
      "items": {"type": "string"}
    },
    "required_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action"],
        "properties": {
          "action": {
            "type": "string",
            "enum": ["add_requirements", "strengthen_specificity", "dedupe_requirements"]
          },
          "count": {"type": ["integer", "null"], "minimum": 0},
          "areas": {
            "type": "array",
            "items": {"type": "string"}
          },
          "ids": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
