{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "blocking_issues",
    "missing_areas",
    "weak_requirements",
    "required_actions"
  ],
  "properties": {
    "blocking_issues": {
      "type": "array",
      "items": {"type": "string"}
    },
    "missing_areas": {
      "type": "array",
      "items": {"type": "string"}
    },
    "weak_requirements": {
      "type": "array",
      "items": {"type": "string"}
    },
    "required_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "severity", "instruction"],
        "properties": {
          "id": {"type": "string"},
          "type": {"type": "string"},
          "severity": {"type": "string", "enum": ["blocking", "non_blocking"]},
          "targets": {
            "type": "array",
            "items": {"type": "string"}
          },
          "area": {"type": ["string", "null"]},
          "instruction": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
